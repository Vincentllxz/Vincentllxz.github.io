---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import NoteCard from '@/components/NoteCard.astro'

export const prerender = true

const meta = {
  description: 'Lecture notes from the course in NTU',
  title: 'Notes'
}

// 學期是自己修課的那一學期（來源是各學期的修課心得）。注意 OS 的
// `notes/os/index.mdx` 裡寫的 `2021 Spring` 是忠緯錄影的年份，不是修課學期。
//
// 這一頁不帶顏色 —— 卡片的 hover 統一用站上的 `--primary`，不一課一色。
const series = [
  {
    title: 'Operating System',
    titleZh: '作業系統',
    teacher: '林忠緯 教授',
    term: '2026 Spring',
    href: '/notes/os',
    type: 'note' as const
  },
  {
    title: 'System Programming',
    titleZh: '系統程式設計',
    teacher: '鄭卜壬 教授',
    term: '2025 Fall',
    href: '/notes/sp',
    type: 'note' as const
  },
  {
    title: 'Computer Networking',
    titleZh: '計算機網路',
    teacher: '逄愛君 教授',
    term: '2025 Fall',
    href: '/notes/cn',
    type: 'note' as const
  }
]

const handouts = [
  {
    title: 'Introduction to Computation Theory',
    titleZh: '自動機與形式語言',
    teacher: '林智仁 教授',
    term: '2025 Fall',
    href: '/pdf/IntroComputation.pdf'
  },
  {
    title: 'Numerical Method',
    titleZh: '數值方法',
    teacher: '林智仁 教授',
    term: '2026 Spring',
    href: '/pdf/NumericalMethod.pdf'
  },
  {
    title: 'Algorithm Design and Analysis',
    titleZh: '演算法設計與分析',
    teacher: '呂學一 教授',
    term: '2025 Fall',
    href: '/pdf/ADA_cut.pdf'
  },
  {
    title: 'Linear Algebra',
    titleZh: '線性代數',
    teacher: '李明穗 教授',
    term: '2025 Fall',
    href: '/pdf/LinearAlgebra.pdf'
  },
  // 這門沒有英文課名，主標就放中文，中文小字那行自然空著。
  {
    title: '東坡詞',
    teacher: '劉少雄 教授',
    term: '2025 Spring',
    href: '/pdf/東坡詞.pdf'
  }
]

// 站內逐章的跟 PDF 的都是同一批筆記，所以同一個網格，不分區、不分先後 ——
// 只按學期新到舊排。`Spring` 屬於該學年的下學期，所以 2026 Spring 比 2025 Fall 新。
// 同一學期維持陣列原本的順序（sort 是穩定的）。
const termRank = (term: string) => {
  const [year, season] = term.split(' ')
  return Number(year) * 10 + (season === 'Fall' ? 1 : 0)
}
const items = [...series, ...handouts].sort((a, b) => termRank(b.term) - termRank(a.term))
---

{/* 版面跟 /blog 同一套：BaseLayout + 頁內 h1 + 一行 text-sm 說明，h1 才不會被
    CommonPage 的 header slot 推遠。 */}
<PageLayout {meta}>
  <Button title='Back' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>Notes</h1>
    </div>

    <section id='content' class='animate' aria-label='Notes list'>
      <div class='mb-3 text-sm text-muted-foreground sm:mb-5'>
        Lecture notes from the course in NTU
      </div>

      <div class='grid grid-cols-1 gap-4 sm:grid-cols-2' data-reveal>
        {items.map((item) => <NoteCard {...item} />)}
      </div>
    </section>
  </main>
</PageLayout>
