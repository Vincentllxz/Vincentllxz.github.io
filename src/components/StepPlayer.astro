---
// 一連串同尺寸的圖（例如 parsing 每一步的狀態），疊在同一格裡，用下方的時間軸切換。
// 每張圖必須裁成一樣大小、一樣的框，切換時沒變的部分才會停在原位，
// 讀者看得出這一步到底改了什麼。
//
// 時間軸可以點、可以拖（拖的時候圖跟著換），聚焦後方向鍵 / Home / End 也能走；
// 左邊的播放鍵會自動走完一次。不會自己開始播。
interface Step {
  /** `/images/...` 底下的路徑。 */
  src: string
  /** 時間軸刻度下的短標籤，例如套用的 production 編號或 match 掉的 token。 */
  label?: string
  /** 這一步做了什麼，顯示在時間軸下方。 */
  caption?: string
}

interface Props {
  steps: Step[]
  /** 整組圖在說什麼，給螢幕閱讀器用。 */
  caption?: string
  /** 圖片寬度，同 `Fig`：數字當百分比，字串原樣輸出。 */
  width?: number | string
  /** 自動播放時每一步停留的毫秒數。 */
  interval?: number
}

const { steps, caption, width, interval = 1400 } = Astro.props
const playerWidth = typeof width === 'number' ? `${width}%` : width
const last = Math.max(steps.length - 1, 1)
const at = (i: number) => `${(i / last) * 100}%`
---

<figure
  class='step-player not-prose'
  style={playerWidth && `--player-width: ${playerWidth}`}
  data-interval={interval}
  aria-label={caption}
>
  <div class='sp-inner'>
    <div class='sp-stage'>
      {
        steps.map((step, i) => (
          <img
            src={step.src}
            alt={step.caption ?? `Step ${i + 1}`}
            class:list={['sp-frame', { 'is-active': i === 0 }]}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding='async'
            draggable='false'
          />
        ))
      }
    </div>

    <div class='sp-bar'>
      <button type='button' class='sp-play' aria-label='播放'>
        <svg class='sp-icon-play' viewBox='0 0 16 16' aria-hidden='true'>
          <path d='M4.5 2.8v10.4a.6.6 0 0 0 .9.5l8.3-5.2a.6.6 0 0 0 0-1L5.4 2.3a.6.6 0 0 0-.9.5Z'
          ></path>
        </svg>
        <svg class='sp-icon-pause' viewBox='0 0 16 16' aria-hidden='true'>
          <rect x='3.5' y='2.5' width='3' height='11' rx='1'></rect>
          <rect x='9.5' y='2.5' width='3' height='11' rx='1'></rect>
        </svg>
      </button>

      <div
        class='sp-track'
        role='slider'
        tabindex='0'
        aria-label='步驟'
        aria-valuemin='1'
        aria-valuemax={steps.length}
        aria-valuenow='1'
        aria-valuetext={steps[0]?.caption}
      >
        <div class='sp-rail'>
          <div class='sp-fill'></div>
          {
            steps.map((_, i) => (
              <span class:list={['sp-dot', { 'is-done': i === 0 }]} style={`left: ${at(i)}`} />
            ))
          }
          <span class='sp-thumb' style='left: 0%'></span>
        </div>
        <div class='sp-labels' aria-hidden='true'>
          {
            steps.map((step, i) => (
              <span class:list={['sp-label', { 'is-active': i === 0 }]} style={`left: ${at(i)}`}>
                {step.label}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <p class='sp-caption' aria-hidden='true'>{steps[0]?.caption}</p>
  </div>

  <template class='sp-captions'>{JSON.stringify(steps.map((s) => s.caption ?? ''))}</template>
</figure>

<script>
  function setup(root: HTMLElement) {
    const frames = [...root.querySelectorAll<HTMLImageElement>('.sp-frame')]
    const dots = [...root.querySelectorAll<HTMLElement>('.sp-dot')]
    const labels = [...root.querySelectorAll<HTMLElement>('.sp-label')]
    const track = root.querySelector<HTMLElement>('.sp-track')!
    const rail = root.querySelector<HTMLElement>('.sp-rail')!
    const fill = root.querySelector<HTMLElement>('.sp-fill')!
    const thumb = root.querySelector<HTMLElement>('.sp-thumb')!
    const play = root.querySelector<HTMLButtonElement>('.sp-play')!
    const captionEl = root.querySelector<HTMLElement>('.sp-caption')!
    const captions: string[] = JSON.parse(
      root.querySelector<HTMLTemplateElement>('.sp-captions')!.content.textContent || '[]'
    )
    const interval = Number(root.dataset.interval) || 1400
    const last = Math.max(frames.length - 1, 1)
    let index = 0
    let timer: number | undefined

    // 時間軸位置（0–1）。拖曳時跟著游標連續移動，放開後才吸到最近的刻度。
    const place = (ratio: number) => {
      thumb.style.left = `${ratio * 100}%`
      fill.style.transform = `scaleX(${ratio})`
    }

    const go = (i: number) => {
      i = Math.max(0, Math.min(frames.length - 1, i))
      if (i === index) return
      // 新圖疊在舊圖上淡入，舊圖保持不透明墊在下面，切換時不會整張變淡。
      frames.forEach((f) => f.classList.remove('is-prev'))
      frames[index].classList.add('is-prev')
      frames[index].classList.remove('is-active')
      frames[i].classList.add('is-active')
      index = i
      dots.forEach((d, j) => d.classList.toggle('is-done', j <= index))
      labels.forEach((l, j) => l.classList.toggle('is-active', j === index))
      captionEl.textContent = captions[index] ?? ''
      track.setAttribute('aria-valuenow', String(index + 1))
      track.setAttribute('aria-valuetext', captions[index] ?? '')
    }

    const snap = (i: number) => {
      go(i)
      place(index / last)
    }

    const stop = () => {
      window.clearInterval(timer)
      timer = undefined
      root.classList.remove('is-playing')
      play.setAttribute('aria-label', '播放')
    }

    const start = () => {
      // 播完再按一次就從頭來。
      if (index === frames.length - 1) snap(0)
      root.classList.add('is-playing')
      play.setAttribute('aria-label', '暫停')
      timer = window.setInterval(() => {
        snap(index + 1)
        if (index === frames.length - 1) stop()
      }, interval)
    }

    play.addEventListener('click', () => (timer ? stop() : start()))

    const ratioAt = (x: number) => {
      const r = rail.getBoundingClientRect()
      return Math.max(0, Math.min(1, (x - r.left) / r.width))
    }
    const drag = (e: PointerEvent) => {
      const ratio = ratioAt(e.clientX)
      place(ratio)
      go(Math.round(ratio * last))
    }
    track.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return
      stop()
      track.setPointerCapture(e.pointerId)
      root.classList.add('is-dragging')
      drag(e)
    })
    track.addEventListener('pointermove', (e) => {
      if (track.hasPointerCapture(e.pointerId)) drag(e)
    })
    const release = () => {
      root.classList.remove('is-dragging')
      place(index / last)
    }
    track.addEventListener('pointerup', release)
    track.addEventListener('pointercancel', release)

    track.addEventListener('keydown', (e) => {
      const target = {
        ArrowLeft: index - 1,
        ArrowDown: index - 1,
        ArrowRight: index + 1,
        ArrowUp: index + 1,
        Home: 0,
        End: last
      }[e.key]
      if (target === undefined) return
      e.preventDefault()
      stop()
      snap(target)
    })
  }

  document.querySelectorAll<HTMLElement>('.step-player').forEach(setup)
</script>

<style>
  .step-player {
    display: flex;
    justify-content: center;
    margin: 2em auto;
  }
  .sp-inner {
    width: var(--player-width, 100%);
    max-width: 100%;
  }

  /* 所有圖疊在同一格，格子高度由圖本身撐開。 */
  .sp-stage {
    display: grid;
  }
  .sp-frame {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    border-radius: 10px;
    opacity: 0;
    user-select: none;
  }
  .sp-frame.is-prev {
    opacity: 1;
  }
  .sp-frame.is-active {
    z-index: 1;
    opacity: 1;
    transition: opacity 220ms ease-out;
  }
  /* 拖曳時跟手，不等淡入。 */
  .is-dragging .sp-frame.is-active {
    transition-duration: 90ms;
  }

  .sp-bar {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: 1.1rem;
  }

  .sp-play {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: -0.5rem;
    border-radius: 999px;
    color: hsl(var(--muted-foreground));
    transition:
      color 150ms,
      background 150ms;
  }
  .sp-play svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: currentColor;
  }
  .sp-play:hover,
  .sp-play:focus-visible,
  .is-playing .sp-play {
    color: hsl(var(--primary-foreground));
    background: hsl(var(--primary));
  }
  .sp-icon-pause,
  .is-playing .sp-icon-play {
    display: none;
  }
  .is-playing .sp-icon-pause {
    display: block;
  }

  /* 整條（含標籤）都是拖曳範圍；圓點左右各留半個 thumb 的空間不被切掉。 */
  .sp-track {
    flex: 1;
    padding: 0 0.5rem;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    outline: none;
  }
  .sp-rail {
    position: relative;
    height: 0.75rem;
  }
  .sp-rail::before,
  .sp-fill {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 2px;
    margin-top: -1px;
    border-radius: 1px;
  }
  .sp-rail::before {
    background: hsl(var(--border));
  }
  .sp-fill {
    background: hsl(var(--primary));
    transform: scaleX(0);
    transform-origin: left;
  }

  .sp-dot,
  .sp-thumb {
    position: absolute;
    top: 50%;
    border-radius: 999px;
    transform: translate(-50%, -50%);
  }
  .sp-dot {
    width: 7px;
    height: 7px;
    background: hsl(var(--background));
    box-shadow: inset 0 0 0 1.5px hsl(var(--border));
    transition: box-shadow 200ms;
  }
  .sp-dot.is-done {
    box-shadow: inset 0 0 0 4px hsl(var(--primary));
  }
  .sp-thumb {
    z-index: 1;
    width: 15px;
    height: 15px;
    background: hsl(var(--primary));
    box-shadow: 0 0 0 4px hsl(var(--primary) / 0.18);
    transition: box-shadow 150ms;
  }
  .sp-track:hover .sp-thumb,
  .sp-track:focus-visible .sp-thumb,
  .is-dragging .sp-thumb {
    box-shadow: 0 0 0 7px hsl(var(--primary) / 0.22);
  }

  /* 不拖的時候 thumb 和填色滑過去；拖的時候直接跟著游標。 */
  .sp-thumb,
  .sp-fill {
    transition-property: left, transform, box-shadow;
    transition-duration: 280ms, 280ms, 150ms;
    transition-timing-function: cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  .is-dragging .sp-thumb,
  .is-dragging .sp-fill {
    transition-duration: 0ms, 0ms, 150ms;
  }

  .sp-labels {
    position: relative;
    height: 1.4rem;
    margin-top: 0.35rem;
  }
  .sp-label {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    white-space: nowrap;
    color: hsl(var(--muted-foreground) / 0.7);
    transition: color 150ms;
  }
  /* 頭尾兩個置中會超出時間軸被切掉，改成往內對齊。 */
  .sp-label:first-child {
    transform: translateX(-0.5rem);
  }
  .sp-label:last-child {
    transform: translateX(calc(-100% + 0.5rem));
  }
  .sp-label.is-active {
    color: hsl(var(--primary));
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .sp-labels {
      display: none;
    }
  }

  .sp-caption {
    min-height: 1.6em;
    margin: 0.4rem 0 0;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
    color: hsl(var(--foreground));
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-frame.is-active,
    .sp-thumb,
    .sp-fill {
      transition: none;
    }
  }
</style>
