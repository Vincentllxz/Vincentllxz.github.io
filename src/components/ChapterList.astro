---
// 課程首頁的章節目錄。刻意不做視窗外框 —— 這一頁上面已經有 CourseIntro 的
// 視窗條了，而這份列表是要被點 10 幾次的東西，安靜、好掃比有裝飾重要。
interface Chapter {
  /** 閱讀順序，也是網址上的編號。 */
  n: number
  title: string
  href?: string
  /** 對應的課本章節號。課程編排跟課本順序不一致時才需要（例如 OS）。 */
  book?: number
}

interface Props {
  chapters: Chapter[]
  /** 主色，hsl 三元組 `H S% L%`；預設終端機藍。 */
  accent?: string
  /** `book` 欄的前綴，例如 `OSC`。有章節帶 `book` 時才會顯示。 */
  bookLabel?: string
}

const { chapters, accent = '217 85% 54%', bookLabel = '' } = Astro.props
const showBook = chapters.some((c) => c.book !== undefined)
---

<ol class='chapterlist not-prose my-6' style={`--ac: ${accent}`}>
  {
    chapters.map((c) => {
      const Tag = c.href ? 'a' : 'div'
      return (
        <li>
          <Tag
            href={c.href}
            data-astro-prefetch={c.href ? true : undefined}
            class:list={['cl-row', c.href ? 'cl-row-link' : 'cl-row-wip']}
            aria-disabled={c.href ? undefined : 'true'}
          >
            <span class='cl-n'>{String(c.n).padStart(2, '0')}</span>
            <span class='cl-title'>{c.title}</span>
            {showBook && (
              <span class='cl-book'>
                {c.book !== undefined ? `${bookLabel} ${c.book}`.trim() : ''}
              </span>
            )}
            <span class='cl-mark' aria-hidden='true'>
              {c.href ? '›' : '整理中'}
            </span>
          </Tag>
        </li>
      )
    })
  }
</ol>

<style>
  .chapterlist {
    --accent: hsl(var(--ac));
    list-style: none;
    margin-inline: 0;
    padding: 0;
    border-top: 1px solid hsl(var(--border));
  }
  /* 中等亮度的色相在深色底上會沉下去，提亮一點。 */
  :global(html.dark) .chapterlist {
    --accent: color-mix(in srgb, hsl(var(--ac)), white 22%);
  }
  .chapterlist li {
    border-bottom: 1px solid hsl(var(--border));
  }

  .cl-row {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.7rem 0.5rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .cl-row-link:hover {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .cl-row-wip {
    opacity: 0.55;
  }

  .cl-n {
    flex-shrink: 0;
    width: 1.6rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--muted-foreground));
  }
  .cl-title {
    flex: 1 1 auto;
    min-width: 0;
    color: hsl(var(--foreground));
    transition: color 0.15s ease;
  }
  .cl-row-link:hover .cl-title {
    color: var(--accent);
  }
  /* 課本章節：對照用的註記，不該跟章名搶。 */
  .cl-book {
    flex-shrink: 0;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: hsl(var(--muted-foreground) / 0.8);
  }
  .cl-mark {
    flex-shrink: 0;
    width: 3rem;
    text-align: end;
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cl-row-link .cl-mark {
    color: var(--accent);
  }
  .cl-row-link:hover .cl-mark {
    transform: translateX(3px);
  }

  @media (max-width: 480px) {
    .cl-book {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cl-row,
    .cl-mark {
      transition: none;
    }
  }
</style>
