---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import avatar from '@/assets/avatar.png'

const posts = (await getCollection('blog', post => !post.data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3)
const date = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Taipei' })
---

<div class="letter">
  <div class="spread">
    <div class="intro">
      <h1 lang="en">Vinsong's blog</h1>
      <p>本來其實都喜歡叫 Vincent 的，但這名字好像太菜市場了一直被用掉，所以只好自己取一個別的名字。</p>
    </div>
    <button class="mail" type="button" aria-label="翻面讀信" aria-pressed="false">
      <span class="mail-art">
        <span class="mail-face front" aria-hidden="true">
          <span class="envelope"><span class="address-lines"></span></span>
          <span class="stamp">
            <Image src={avatar} alt="" width={380} loading="eager" />
          </span>
          <span class="postmark">臺北</span>
          <span class="waves"><i></i><i></i><i></i></span>
        </span>
        <span class="mail-face back" aria-hidden="true">
          <span class="back-body" id="letter-message">我很喜歡紀錄生活，無論是用文字、照片還是影片，只要能留下什麼，我就會想做做看。</span>
          <span class="signature">VinSong</span>
        </span>
      </span>
      <span class="flip-label" data-mail-label>翻面讀信</span>
    </button>
  </div>

  <section class="journal" id="journal" aria-labelledby="journal-heading">
    <div class="journal-top">
      <h2 id="journal-heading">近期文章</h2>
      <a href="/blog">全部文章</a>
    </div>
    <ul>
      {posts.map(post => {
        const isoDate = date.format(post.data.publishDate)
        return (
          <li><a class="entry" href={'/blog/' + post.id}>
            <time datetime={isoDate}>{isoDate.replaceAll('-', '.')}</time>
            <strong>{post.data.title}</strong>
          </a></li>
        )
      })}
    </ul>
  </section>
</div>

<script>
  const mail = document.querySelector<HTMLButtonElement>('.mail')!
  mail.addEventListener('click', () => {
    const opened = mail.getAttribute('aria-pressed') !== 'true'
    const label = opened ? '翻回正面' : '翻面讀信'
    mail.setAttribute('aria-pressed', String(opened))
    mail.setAttribute('aria-label', label)
    if (opened) mail.setAttribute('aria-describedby', 'letter-message')
    else mail.removeAttribute('aria-describedby')
    mail.querySelector('[data-mail-label]')!.textContent = label
  })
</script>

<style>
  .letter {
    --paper: #f7f4ea;
    --ink: #252d3c;
    --red: #b5412b;
    background-color: var(--paper);
    background-image: repeating-linear-gradient(5deg, #a9824c05 0 1px, transparent 1px 4px), repeating-linear-gradient(95deg, #a9824c04 0 1px, transparent 1px 3px);
    padding: 0 clamp(20px, 5.5vw, 80px) 44px;
    color: var(--ink);
  }
  .spread, .journal {max-width: 1240px; margin: auto;}
  .spread {
    display: grid; grid-template-columns: 1.1fr 1fr;
    align-items: center; gap: clamp(16px, 3.8vw, 64px); padding: clamp(32px, 3.5vw, 56px) 0;
  }
  h2, .back-body {font-family: "Songti TC", "Noto Serif TC", "PMingLiU", Georgia, serif;}
  h1 {font: 500 clamp(46px, 5.35vw, 81px)/1.12 Baskerville, "Palatino Linotype", Georgia, serif; margin: 0;}
  .intro p {max-width: 25em; font-size: clamp(16px, 1.25vw, 18px); line-height: 1.9; margin: 20px 0 0; color: #464b4e; text-wrap: balance;}
  .mail {width: min(100%, 405px); justify-self: center; display: flex; flex-direction: column; align-items: flex-end; cursor: pointer; background: none; border: none; padding: 0; color: inherit; text-align: left; perspective: 1000px;}
  .mail-art {display: block; position: relative; width: 100%; aspect-ratio: 1.47; transform-style: preserve-3d; transition: transform .55s cubic-bezier(.22,.68,.18,1);}
  .mail[aria-pressed="true"] .mail-art {transform: rotateY(180deg);}
  .mail-face {position: absolute; inset: 0; display: block; backface-visibility: hidden; -webkit-backface-visibility: hidden;}
  .envelope, .back {
    background: repeating-linear-gradient(37deg, #b44334 0 10px, #ede7d5 10px 20px, #445b72 20px 30px, #ede7d5 30px 40px);
    box-shadow: 0 6px 9px #4c3b1b19, 0 1px 2px #4c3b1b38;
  }
  .envelope {position: absolute; left: 2%; right: 5%; top: 21%; bottom: 4%; transform: rotate(-6deg);}
  .envelope::before, .back::before {content: ""; position: absolute; inset: 5px; background: #e8e2cf;}
  .address-lines {position: absolute; bottom: 18%; left: 9%; width: 40%; height: 26%; background: repeating-linear-gradient(to top, #8b8c7c 0 1px, transparent 1px 33.333%); opacity: .65;}
  .stamp {position: absolute; width: 56%; right: 9%; top: 3%; padding: 9px; background: #fffaf0; transform: rotate(4deg);
    mask: linear-gradient(#000 0 0) center / calc(100% - 12px) calc(100% - 12px) no-repeat,
      radial-gradient(circle at 6px 0, transparent 3px, #000 3.5px) 0 0 / 12px 51% repeat-x,
      radial-gradient(circle at 6px 100%, transparent 3px, #000 3.5px) 0 100% / 12px 51% repeat-x;
  }
  .stamp img {display: block; width: 100%; height: auto;}
  .postmark {position: absolute; top: 45%; left: 23%; width: 14%; aspect-ratio: 1; display: grid; place-items: center; border: 1px solid currentColor; border-radius: 50%; color: #55594f; transform: rotate(-12deg); font: 600 clamp(12px, 1.2vw, 17px)/1 "Songti TC", serif;}
  .waves {position: absolute; width: 18%; height: 9%; left: 37%; top: 50%; transform: rotate(-10deg); opacity: .6;}
  .waves i {display: block; height: 26%; border-top: 1.5px solid #55594f; border-radius: 50% 38% 0 0;}
  .back {inset: 11% 4% 3%; transform: rotateY(180deg) rotate(-3deg); padding: 9% 9% 6%; display: flex; flex-direction: column; justify-content: center;}
  .back::before {background: #f1ebda;}
  .back > span {position: relative;}
  .back-body {font-size: clamp(14px,1.25vw,18px); line-height: 1.75; margin: 9px 0;}
  .signature {align-self: flex-end; font: italic 24px Baskerville, Georgia, serif;}
  .flip-label {font-size: 13px; color: #55584e; margin: 3% 6% 0 0; text-decoration: underline; text-underline-offset: .25em;}
  .mail:hover .flip-label {color: var(--red);}
  .journal {border-top: 1px solid #bbb9ad;}
  .journal-top {display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 0 6px;}
  h2 {margin: 0; font-size: clamp(25px, 2.2vw, 36px);}
  .journal-top a {display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; text-underline-offset: .25em;}
  ul {list-style: none; padding: 0; margin: 0;}
  .entry {min-height: 48px; display: grid; align-items: baseline; grid-template-columns: 100px 1fr; gap: 16px; padding: 10px 0; text-decoration: none;}
  time {font-size: 13px; color: #67685f; font-variant-numeric: tabular-nums;}
  .entry strong {font-size: clamp(16px, 1.32vw, 21px); font-weight: 600; text-decoration: underline; text-decoration-color: #aaa69b; text-decoration-thickness: 1px; text-underline-offset: .23em;}
  .entry:hover, .journal-top a:hover {color: var(--red);}
  .entry:hover strong, .entry:focus-visible strong {text-decoration-color: currentColor;}
  @media (max-width: 850px) {.spread {gap: 16px;} .stamp {padding: 8px;}}
  @media (max-width: 650px) {
    .spread {grid-template-columns: 1fr; gap: 14px; padding: 24px 0;}
    h1 {font-size: clamp(42px, 10.8vw, 58px);}
    .intro p {margin: 14px 0 7px;}
    .mail {width: min(83%, 290px);}
    .flip-label {margin-top: 1%;}
    .journal-top {padding: 12px 0 3px;}
    .entry {grid-template-columns: 1fr; gap: 2px; min-height: 60px;}
    time {grid-column: 1; font-size: 12px;}
    .entry strong {grid-column: 1;}
  }
  @media (prefers-reduced-motion: reduce) {.mail-art {transition: none;}}
</style>
